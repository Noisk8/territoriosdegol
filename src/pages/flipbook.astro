---
import Layout from '../layouts/Layout.astro';
import FlipBook from "../components/FlipBook.jsx";

const SEO = {
  title: 'Territorios de GOL | Libro Interactivo',
  description: 'Explora las páginas de nuestro libro interactivo con historias y sonidos.'
};
---

<Layout title={SEO.title} description={SEO.description}>
  <div class="container mx-auto py-8">
    <h1 class="text-3xl font-bold text-center mb-8">Territorios de GOL</h1>
    <FlipBook client:load />
  </div>
</Layout>
