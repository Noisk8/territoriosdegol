---
// Página de Audios
// ------------
// Lista creativa de relatos sonoros con reproductor y portada

// Layout
import Layout from '../layouts/Layout.astro'
// UI helpers (consistencia visual)
import Section from '../components/ui/Section.astro'
import Row from '../components/ui/Row.astro'
import Col from '../components/ui/Col.astro'
import Hero from '../components/blocks/hero/PageHeader.astro'

// Data
import { audioTracks } from '../config/audio'

const SEO = {
  title: 'Territorios de GOL | Audios',
  description: 'Escucha los relatos sonoros del proyecto Territorios de GOL.'
}
---

<Layout title={SEO.title} description={SEO.description}>
  <Hero title="Relatos <strong>Sonoros</strong>" text="Historias de fútbol en Medellín para escuchar y sentir." />

  <Section>
    <Row>
      {
        audioTracks.map((track, i) => (
          <Col span="4">
            <article class="card">
              <div class="card__media">
                {track.cover && <img src={track.cover} alt={`Portada de ${track.title}`} class="card__img" />}
                <button class="card__play" data-audio-target={`audio-${i}`} aria-label={`Reproducir ${track.title}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path d="M8 5.14v14l11-7-11-7z" />
                  </svg>
                </button>
              </div>

              <div class="card__body">
                <h3 class="card__title">{track.title}</h3>
                {track.description && <p class="card__text">{track.description}</p>}
                {track.tags && (
                  <ul class="card__tags">
                    {track.tags.map((t) => (<li>{t}</li>))}
                  </ul>
                )}
                <audio id={`audio-${i}`} class="card__audio" src={track.src} preload="metadata" controls></audio>
              </div>
            </article>
          </Col>
        ))
      }
    </Row>
  </Section>

  <script>
    // Permitir una sola reproducción a la vez y botón play sobre la portada
    const audios = Array.from(document.querySelectorAll('.card__audio')) as HTMLAudioElement[]

    function pauseOthers(except: HTMLAudioElement | null) {
      audios.forEach((a: HTMLAudioElement) => {
        if (a !== except) { a.pause() }
      })
    }

    audios.forEach((a: HTMLAudioElement) => {
      a.addEventListener('play', () => pauseOthers(a))
    })

    document.querySelectorAll<HTMLButtonElement>('.card__play').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-audio-target')
        if (!id) return
        const el = document.getElementById(id) as HTMLAudioElement | null
        if (!el) return
        if (el.paused) {
          pauseOthers(el)
          el.play().catch(() => {})
        } else {
          el.pause()
        }
      })
    })
  </script>
</Layout>

<style>
  .card { @apply overflow-hidden rounded-xl border border-neutral-100 bg-white shadow-sm transition-transform duration-300 hover:-translate-y-1 hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900; }
  .card__media { @apply relative aspect-video overflow-hidden bg-neutral-100 dark:bg-neutral-800; }
  .card__img { @apply h-full w-full object-cover; }
  .card__play { @apply absolute inset-0 m-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary-500 text-white shadow-md ring-4 ring-white/60 transition hover:bg-primary-600 focus:outline-none; }
  .card__body { @apply p-4; }
  .card__title { @apply mb-2 text-xl font-bold text-neutral-800 dark:text-neutral-50; }
  .card__text { @apply mb-3 text-neutral-600 dark:text-neutral-300; }
  .card__tags { @apply mb-4 flex flex-wrap gap-2 text-sm text-neutral-500; }
  .card__tags li { @apply rounded-full bg-neutral-100 px-3 py-1 dark:bg-neutral-800; }
  .card__audio { @apply w-full; }
</style>
