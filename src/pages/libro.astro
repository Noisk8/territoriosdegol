---
import Layout from '../layouts/Layout.astro';
import FlipBook from "../components/FlipBook.jsx";

const SEO = {
  title: 'Libro | Territorios de GOL',
  description: 'Explora las páginas de nuestro libro interactivo con historias y sonidos.'
};
---

<Layout title={SEO.title} description={SEO.description}>
  <section class="min-h-[calc(100vh-6rem)] grid place-items-center pt-24 pb-12 px-4">
   <FlipBook client:load />
  </section>
</Layout>
