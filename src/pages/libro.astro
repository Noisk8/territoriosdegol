---
import Layout from '../layouts/Layout.astro'
import FlipBook from "../components/FlipBook.jsx"

// Collage sources and duplication to increase density
const sources = [
  '/PORTADA_FIN.png',
  '/PAGINA_1.png',
  '/PAGINA_3.png',
  '/HISTORIA1.png',
  '/HISTORIA2.png',
  '/PAGINA_5.png',
  '/PAGINA_6.png',
  '/PAGINA_7.png',
  '/PAGINA_8.png',
  '/PAGINA_9.png',
  '/Ana.png',
  '/PAGINA_10.png',
  '/PAGINA_11.png',
  '/PAGINA_12.png',
  '/Guayos.png',
  '/Malla.png'
]
const gridImages = [...sources, ...sources, ...sources, ...sources]

const SEO = {
  title: 'Libro | Territorios de GOL',
  description: 'Explora las páginas de nuestro libro interactivo con historias y sonidos.'
};
---

<Layout title={SEO.title} description={SEO.description}>
  <!-- Fondo en collage con tono y transparencia -->
  <div class="libro-bg" aria-hidden="true">
    <div class="libro-bg__grid libro-bg__grid--back">
      {gridImages.map((src, i) => (
        <div class={`libro-bg__cell libro-bg__cell--${(i % 6) + 1}`}>
          <img src={src} alt="" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
    <div class="libro-bg__grid libro-bg__grid--front">
      {gridImages.map((src, i) => (
        <div class={`libro-bg__cell libro-bg__cell--${(i % 6) + 1}`}>
          <img src={src} alt="" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
    <div class="libro-bg__tone" />
  </div>

  <section class="relative min-h-[calc(100vh-6rem)] grid place-items-center pt-24 pb-12 px-4">
    <FlipBook client:load />
  </section>

  <style>
    .libro-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .libro-bg__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 24vmin;
      gap: 0.75rem;
      width: 120%;
      height: 120%;
      padding: 3rem 1rem 6rem;
      opacity: 0.5;
      filter: saturate(0.85);
      will-change: transform;
    }
    .libro-bg__grid--back { transform: translateY(0); }
    .libro-bg__grid--front { transform: translateY(0); }
    @media (min-width: 768px) {
      .libro-bg__grid { grid-template-columns: repeat(6, 1fr); grid-auto-rows: 16vmin; padding: 4rem 2rem 8rem; }
    }
    .libro-bg__cell { position: relative; overflow: hidden; border-radius: 0.5rem; }
    .libro-bg__cell img {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
      filter: grayscale(0.6) contrast(1.05) brightness(1.05);
      opacity: 0.42;
      transform: scale(1.06);
    }
    .libro-bg__cell--1 img { opacity: 0.36; }
    .libro-bg__cell--2 img { opacity: 0.46; filter: grayscale(0.65) contrast(1.05) brightness(1.05); }
    .libro-bg__cell--3 img { opacity: 0.40; transform: scale(1.1); }
    .libro-bg__cell--4 img { opacity: 0.38; }
    .libro-bg__cell--5 img { opacity: 0.48; }
    .libro-bg__cell--6 img { opacity: 0.34; }

    .libro-bg__tone { position: absolute; inset: 0; background:
      linear-gradient(180deg, rgba(2,6,23,0.55) 0%, rgba(2,6,23,0.50) 20%, rgba(2,6,23,0.45) 100%),
      radial-gradient(80rem 50rem at 80% 10%, rgba(226, 24, 125, 0.12), transparent 60%),
      radial-gradient(70rem 40rem at 20% 100%, rgba(226, 24, 125, 0.14), transparent 60%);
      mix-blend-mode: multiply; pointer-events: none;
    }

    section { position: relative; z-index: 1; }
  </style>

  <script>
    // Parallax suave entre dos capas
    const back = document.querySelector('.libro-bg__grid--back')
    const front = document.querySelector('.libro-bg__grid--front')
    const onScroll = () => {
      const y = window.scrollY || 0
      if (back) back.setAttribute('style', `transform: translateY(${y * 0.05}px);`)
      if (front) front.setAttribute('style', `transform: translateY(${y * 0.10}px);`)
    }
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })
  </script>
</Layout>
